<?xml version="1.0" encoding="utf-8"?>
<!-- Card of a widget that needs you: a gold hairline and a warm top. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@color/lw_card"
        android:centerY="0.62"
        android:endColor="@color/lw_card"
        android:startColor="@color/lw_card_hero_top" />
    <corners android:radius="@dimen/lw_radius" />
    <stroke
        android:width="1dp"
        android:color="@color/lw_card_hero_stroke" />
</shape>
