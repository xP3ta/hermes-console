<?xml version="1.0" encoding="utf-8"?>
<!-- One room of a board: the faces of its members (overlapped, "+2" when
     there are more), its name over who answers or what was last said, and
     at the end the timer of a running round. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lw_row"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/lw_room_faces"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/lw_room_face"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/lw_room_more"
        style="@style/LW.Text.Sub"
        android:layout_marginStart="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/lw_row_texts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/lw_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lw_row_title"
            style="@style/LW.Text.Medium.Title"
            android:layout_width="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/lw_line_sub"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/lw_row_mark"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/lw_dot"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lw_row_sub"
                style="@style/LW.Text.Sub"
                android:layout_width="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <Chronometer
        android:id="@+id/lw_row_timer"
        style="@style/LW.Text.Medium.Timer"
        android:layout_marginStart="@dimen/lw_gap"
        android:visibility="gone" />
</LinearLayout>
