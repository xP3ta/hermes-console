<?xml version="1.0" encoding="utf-8"?>
<!-- Ahora in one row when the agent needs you: who asks and what, and under
     it the answer buttons. Each button is a 32 dp pill inside a 48 dp tall
     tap box; the row of tap boxes overlaps the title by 4 dp so the pills
     sit 4 dp under it, and the 8 dp of top padding balance the 8 dp of tap
     box left under the pills: what you see is centred in the card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/LW.Card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lw_card_hero"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="@dimen/lw_strip_pad"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/lw_strip_pad">

    <LinearLayout
        android:id="@+id/lw_ask_line"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp">

            <ImageView
                android:id="@+id/lw_ask_glyph"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/lw_okc_chip"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/ic_console_mark" />

            <ImageView
                android:id="@+id/lw_ask_face"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/lw_ask_title"
            style="@style/LW.Text.Medium"
            android:layout_marginStart="7dp" />

        <TextView
            android:id="@+id/lw_ask_detail"
            style="@style/LW.Text.Mono"
            android:layout_width="0dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1" />
    </LinearLayout>

    <include
        layout="@layout/lw_buttons"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lw_touch"
        android:layout_marginTop="-4dp" />
</LinearLayout>
