<?xml version="1.0" encoding="utf-8"?>
<!-- What needs you, on a board: who asks (small) over what is asked. The
     face is centred on the two lines. Tapping it opens the conversation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lw_ask"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="39dp"
    android:orientation="horizontal"
    android:paddingBottom="1dp">

    <FrameLayout
        android:layout_width="@dimen/lw_lead"
        android:layout_height="@dimen/lw_lead"
        android:layout_marginEnd="@dimen/lw_gap">

        <ImageView
            android:id="@+id/lw_ask_glyph"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/lw_okc_chip"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/ic_console_mark" />

        <ImageView
            android:id="@+id/lw_ask_face"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lw_ask_title"
            style="@style/LW.Text.Sub"
            android:layout_width="match_parent" />

        <TextView
            android:id="@+id/lw_ask_detail"
            style="@style/LW.Text.Medium.Title"
            android:layout_width="match_parent" />
    </LinearLayout>
</LinearLayout>
