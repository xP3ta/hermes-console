<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview of Needs you (v2): black card, amber bottom glow, plain
     row + Approve/Deny. RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/botw_glow_needs_you"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/botw_preview_face_lead_needs" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="start" android:maxLines="1" android:text="lead · Atlas" android:textColor="@color/botw_preview_text" android:textSize="13.5sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="start" android:maxLines="1" android:text="@string/botw_preview_approval" android:textColor="@color/botw_preview_secondary" android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="@string/botw_approve" android:textColor="@color/botw_preview_background" android:textSize="12.5sp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/botw_pill_amber" android:textStyle="bold"/>
        <FrameLayout android:layout_width="6dp" android:layout_height="match_parent" />
        <TextView android:layout_width="0dp" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="@string/botw_deny" android:textColor="@color/botw_preview_text" android:textSize="12.5sp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/botw_pill_glass" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
