<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview of Room (v2): black card, blue bottom glow, member faces
     in a clean row with state words, last line and a discreet Stop.
     RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/botw_glow_working"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="start" android:maxLines="1" android:text="@string/botw_preview_room_name" android:textColor="@color/botw_preview_title" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:gravity="center_horizontal" android:orientation="vertical">
            <ImageView android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/botw_preview_face_builder_working" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="builder" android:textColor="@color/botw_preview_title" android:textSize="10sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="@string/botw_state_working" android:textColor="@color/botw_text_working" android:textSize="9.5sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:gravity="center_horizontal" android:orientation="vertical">
            <ImageView android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/botw_preview_face_review_done" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="review" android:textColor="@color/botw_preview_title" android:textSize="10sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="@string/botw_state_replied" android:textColor="@color/botw_text_done" android:textSize="9.5sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:gravity="center_horizontal" android:orientation="vertical">
            <ImageView android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/botw_preview_face_lead_idle" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="lead" android:textColor="@color/botw_preview_title" android:textSize="10sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="@string/botw_idle" android:textColor="@color/botw_preview_secondary" android:textSize="9.5sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="start" android:maxLines="1" android:text="@string/botw_preview_room_line" android:textColor="@color/botw_preview_secondary" android:textSize="11.5sp" android:layout_weight="1"/>
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="8dp" android:src="@drawable/botw_ic_stop" android:tint="@color/botw_preview_secondary" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="@string/botw_stop" android:textColor="@color/botw_preview_secondary" android:textSize="11sp" android:layout_marginStart="4dp"/>
    </LinearLayout>
</LinearLayout>
