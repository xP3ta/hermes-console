<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/new_session_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/new_session_widget_background"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minWidth="180dp"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:theme="@style/NewSessionWidgetTheme">

    <LinearLayout
        android:id="@+id/new_session_widget_composer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/new_session_widget_control_background"
        android:contentDescription="@string/new_session_widget_composer_description"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/new_session_widget_composer_hint"
            android:textColor="@color/new_session_widget_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/new_session_widget_voice"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:background="@drawable/new_session_widget_control_background"
        android:contentDescription="@string/new_session_widget_voice_description"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:padding="9dp"
        android:src="@drawable/ic_new_session_widget_voice" />
</LinearLayout>
