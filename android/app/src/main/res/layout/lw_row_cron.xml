<?xml version="1.0" encoding="utf-8"?>
<!-- One scheduled job: when it runs next (time over day) and, beside it, its
     name over how the last run went. The two columns share the same two
     line boxes (19 + 17 sp), so "17:00" sits on the name's line and "hoy"
     on the result's. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lw_row"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/lw_cron_when"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/lw_gap"
        android:minWidth="46dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lw_cron_time"
            style="@style/LW.Text.Medium.Clock" />

        <TextView
            android:id="@+id/lw_cron_day"
            style="@style/LW.Text.Sub"
            android:textColor="@color/lw_faint" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lw_row_texts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lw_row_title"
            style="@style/LW.Text.Medium.Title"
            android:layout_width="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/lw_line_sub"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/lw_row_mark"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/lw_ic_check"
                android:tint="@color/lw_green"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lw_row_sub"
                style="@style/LW.Text.Sub"
                android:layout_width="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
