<?xml version="1.0" encoding="utf-8"?>
<!-- One-row widget of any subject: a 34 dp lead (a bot face, or an icon on a
     chip), up to three lines of text and, at the end, a timer or a time.
     The lead and the text block are centred on the same line: the block is
     19 + 17 (+ 17) sp tall whatever the font, because each line has its own
     fixed box. The whole card is one tap target.
     The sample content below is what the widget picker shows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/LW.Card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/lw_strip_pad"
    android:paddingEnd="@dimen/lw_strip_pad">

    <FrameLayout
        android:id="@+id/lw_lead"
        android:layout_width="@dimen/lw_lead"
        android:layout_height="@dimen/lw_lead">

        <ImageView
            android:id="@+id/lw_lead_glyph"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/lw_icb"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:src="@drawable/lw_ic_clock"
            android:tint="@color/lw_muted" />

        <ImageView
            android:id="@+id/lw_lead_face"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/lw_texts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/lw_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lw_title"
            style="@style/LW.Text.Medium.Title"
            android:layout_width="match_parent"
            android:text="@string/lw_sample_cron_job" />

        <LinearLayout
            android:id="@+id/lw_sub_row"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/lw_line_sub"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lw_sub"
                style="@style/LW.Text.Sub"
                android:layout_weight="1"
                android:text="@string/lw_sample_cron_next" />

            <Chronometer
                android:id="@+id/lw_sub_timer"
                style="@style/LW.Text.Medium.Timer"
                android:layout_height="@dimen/lw_line_sub"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/lw_sub2"
            style="@style/LW.Text.Sub"
            android:layout_width="match_parent"
            android:visibility="gone" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/lw_end_timer"
        style="@style/LW.Text.Medium.Timer"
        android:layout_marginStart="@dimen/lw_gap"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lw_end_time"
        style="@style/LW.Text.Time"
        android:layout_marginStart="@dimen/lw_gap"
        android:visibility="gone" />
</LinearLayout>
