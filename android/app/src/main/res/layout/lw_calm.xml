<?xml version="1.0" encoding="utf-8"?>
<!-- The state of a board in one line: a round mark and a few words ("Todo
     tranquilo", "Sin conexión"), up to two lines, and under them, when
     there is something to add, a line of what to do. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lw_calm"
    android:layout_width="match_parent"
    android:layout_height="@dimen/lw_touch"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/lw_calm_mark"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="@dimen/lw_gap"
        android:background="@drawable/lw_okc_green"
        android:importantForAccessibility="no"
        android:padding="6.5dp"
        android:src="@drawable/lw_ic_check" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lw_calm_title"
            style="@style/LW.Text.Medium.Calm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="@string/lw_calm" />

        <TextView
            android:id="@+id/lw_calm_sub"
            style="@style/LW.Text.Sub"
            android:layout_width="match_parent"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
