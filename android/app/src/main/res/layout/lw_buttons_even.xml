<?xml version="1.0" encoding="utf-8"?>
<!-- Answer buttons of a two-cell card: two pills of the same width. Each
     label is centred in its pill; the paddings are small and equal so
     "Rechazar" fits in half of a narrow card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lw_buttons"
    android:layout_width="match_parent"
    android:layout_height="@dimen/lw_touch"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/lw_button_yes"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <TextView
            android:id="@+id/lw_button_yes_label"
            style="@style/LW.Text.Medium.Button.Go"
            android:layout_width="match_parent"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/lw_allow" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/lw_button_no"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/lw_button_gap"
        android:layout_weight="1">

        <TextView
            android:id="@+id/lw_button_no_label"
            style="@style/LW.Text.Medium.Button"
            android:layout_width="match_parent"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/lw_deny" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/lw_button_open"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:visibility="gone">

        <TextView
            android:id="@+id/lw_button_open_label"
            style="@style/LW.Text.Medium.Button"
            android:text="@string/lw_open" />
    </FrameLayout>
</LinearLayout>
